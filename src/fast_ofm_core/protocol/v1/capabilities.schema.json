{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fast-ofm.org/schema/protocol/v1/capabilities.schema.json",
  "title": "Fast OFM Core capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["core_version", "protocol_versions", "operations", "implementation"],
  "properties": {
    "core_version": {"type": "string", "minLength": 1},
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform", "native_rg_nmi", "rg_nmi_backend", "stitching_worker"],
      "properties": {
        "python": {"type": "string"},
        "platform": {"type": "string"},
        "native_rg_nmi": {"type": "boolean"},
        "rg_nmi_backend": {"enum": ["native-exhaustive", "opencv-exhaustive"]},
        "stitching_worker": {"type": "boolean"}
      }
    },
    "experimental_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}
