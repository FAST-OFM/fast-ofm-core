{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fast-ofm.org/schema/protocol/v1/stitch-manifest.schema.json",
  "title": "Fast OFM verified tile manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tiles"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "common.schema.json#/$defs/artifact"}
    }
  }
}
