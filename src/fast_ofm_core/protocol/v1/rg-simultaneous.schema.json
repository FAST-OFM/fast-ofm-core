{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fast-ofm.org/schema/protocol/v1/rg-simultaneous.schema.json",
  "title": "Fast OFM simultaneous RED+GREEN RAW payloads and results",
  "$defs": {
    "channel_offsets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "integer"}
      }
    },
    "calibrate_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "settings", "channel_offsets_xy", "white_level"],
      "properties": {
        "input": {"$ref": "common.schema.json#/$defs/artifact"},
        "settings": {"type": "object"},
        "channel_offsets_xy": {"$ref": "#/$defs/channel_offsets"},
        "white_level": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "calibrate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arrays", "fit_report", "validation"],
      "properties": {
        "arrays": {"$ref": "common.schema.json#/$defs/artifact"},
        "fit_report": {"type": "object"},
        "validation": {"type": "object"}
      }
    },
    "focus_sample_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "settings",
        "channel_offsets_xy",
        "white_level",
        "boxes",
        "adaptive_window_selection",
        "inspect_periphery"
      ],
      "properties": {
        "input": {"$ref": "common.schema.json#/$defs/artifact"},
        "settings": {"type": "object"},
        "channel_offsets_xy": {"$ref": "#/$defs/channel_offsets"},
        "white_level": {"type": "number", "exclusiveMinimum": 0},
        "boxes": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "object"}}
          ]
        },
        "adaptive_window_selection": {"type": "boolean"},
        "inspect_periphery": {"type": "boolean"}
      }
    },
    "focus_sample_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "boxes", "residual_p95", "valid_fraction", "peripheral_search"],
      "properties": {
        "measurement": {"type": "object"},
        "boxes": {"type": "array", "items": {"type": "object"}},
        "residual_p95": {"type": ["number", "null"], "minimum": 0},
        "valid_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "peripheral_search": {"type": ["object", "null"]}
      }
    },
    "focus_plan_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings"],
      "properties": {"settings": {"type": "object"}}
    },
    "focus_plan_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_order_um"],
      "properties": {
        "capture_order_um": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number"}
        }
      }
    },
    "focus_fit_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings", "observations"],
      "properties": {
        "settings": {"type": "object"},
        "observations": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "focus_fit_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curve"],
      "properties": {"curve": {"type": "object"}}
    },
    "focus_evaluate_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curve", "measurement", "settings", "peripheral_search"],
      "properties": {
        "curve": {"type": "object"},
        "measurement": {"type": "object"},
        "settings": {"type": "object"},
        "peripheral_search": {"type": ["object", "null"]}
      }
    },
    "focus_evaluate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "peripheral_validation"],
      "properties": {
        "measurement": {"type": "object"},
        "peripheral_validation": {"type": ["object", "null"]},
        "defocus_um": {"type": "number"},
        "cross_track_px": {"type": "number"}
      }
    }
  }
}
